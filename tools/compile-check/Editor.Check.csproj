<!-- Full Editor-assembly type-check; run through check-editor.sh, which prepares obj/editor-src. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>CatapultGames.Editor</AssemblyName>
    <NoWarn>CS0649;CS0414;CS0169;CS1701;CS1702;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="obj/editor-src/**/*.cs" />
    <Compile Include="stubs/EditorShims.cs" />
    <Compile Include="stubs/UiToolkitFields.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Runtime.Check.csproj" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" />
    <PackageReference Include="Unity3D.UnityEditor" Version="2018.1.6-f1" PrivateAssets="all" />
  </ItemGroup>
</Project>
